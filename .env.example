# Copy this file to ".env" and fill in the real values. Never commit ".env".

# ---- HitPay (Settings > Payment Gateway > API Keys in your HitPay dashboard) ----
HITPAY_API_KEY=your-hitpay-business-api-key
HITPAY_WEBHOOK_SALT=your-hitpay-webhook-salt
HITPAY_ENV=sandbox
# HITPAY_ENV=live

# ---- WhatsApp Cloud API (business.facebook.com > WhatsApp > API Setup) ----
# This is the ONE business WhatsApp account/number that sends the
# notification. WHATSAPP_TO_NUMBER is the number that receives it (91163266).
WHATSAPP_TOKEN=your-permanent-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_TO_NUMBER=6591163266
# Set to a template name if you have one approved for order notifications
# and the recipient hasn't messaged you in the last 24h. Leave blank to
# send a plain text message (only works inside a 24h customer-service window).
WHATSAPP_TEMPLATE_NAME=

# ---- General ----
PORT=4000
# Comma-separated list of origins allowed to call this API (your storefront's domain[s])
ALLOWED_ORIGINS=https://www.hokey.com.sg,http://localhost:5500
